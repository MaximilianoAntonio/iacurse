!.env.local.example

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
test
prompt

server.log
# Skills directory
/skills/

# ---------------------------------------------------------------------------
# Capturas de QA/auditoria sueltas en la raiz (artifacts, no codigo fuente)
# ---------------------------------------------------------------------------
/*.png
/*.jpeg
/*.jpg
/*.gif
/*.webp

# Tooling artifacts
/tool-results/
/.zscripts/
/.zcode/

# Respaldos de base de datos (contienen datos; nunca versionar)
/backups/

