# Backend .env (copia a backend/.env para uso local fuera de Docker)
# En Docker, estas variables las inyecta docker-compose.yml

POSTGRES_DB=electromed
POSTGRES_USER=electromed
POSTGRES_PASSWORD=electromed
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://electromed:electromed@localhost:5432/electromed

DJANGO_SECRET_KEY=dev-insecure-key-change-in-prod
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=America/Santiago

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GEMINI_API_KEY=
