// Prisma schema - Plataforma de Aprendizaje Adaptativo Electromedicina II
// Piloto de Innovación Docente - Universidad de Valparaíso

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id          String   @id @default(cuid())
  email       String   @unique
  name        String
  role        String   @default("student") // "student" | "teacher"
  avatar      String?
  points      Int      @default(0)
  streak      Int      @default(0)
  lastActive  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attempts      Attempt[]
  progress      Progress[]
  chatMessages  ChatMessage[]
  studySessions StudySession[]
  userBadges    UserBadge[]
  selfAssess    SelfAssessment[]
  errorReports  ErrorReport[]
}

model Unit {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String
  description String
  icon        String
  color       String
  order       Int
  lessons     Lesson[]
  progress    Progress[]
}

model Lesson {
  id          String   @id @default(cuid())
  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  slug        String
  title       String
  description String
  content     String
  durationMin Int      @default(15)
  order       Int
  activities  Activity[]
}

model Activity {
  id         String   @id @default(cuid())
  lessonId   String
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type       String   // "multiple_choice" | "guided_problem" | "case_analysis" | "progressive_exercise" | "self_assessment"
  title      String
  prompt     String
  data       String   // JSON: options, answer, hints, steps, explanation, rubric, etc.
  points     Int      @default(10)
  difficulty String   @default("medium") // "easy" | "medium" | "hard"
  order      Int
  attempts   Attempt[]
}

model Attempt {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  answer     String
  feedback   String?
  score      Int?
  correct    Boolean?
  timeSpent  Int?
  createdAt  DateTime @default(now())
}

model Progress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  completed   Int      @default(0)
  total       Int      @default(0)
  mastery     Int      @default(0) // 0-100
  lastVisited DateTime?
  updatedAt   DateTime @updatedAt

  @@unique([userId, unitId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   // "user" | "assistant"
  content   String
  context   String?
  rating    Int?     // 1-5 feedback from student
  createdAt DateTime @default(now())
}

model StudySession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId    String?
  startedAt DateTime @default(now())
  duration  Int      @default(0)
}

model Badge {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  icon        String
  tier        String   @default("bronze") // "bronze" | "silver" | "gold"
  userBadges  UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

model SelfAssessment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId     String?
  confidence Int      // 1-5 student self-reported confidence
  reflection String?
  createdAt  DateTime @default(now())
}

model ErrorReport {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source      String   // "chat" | "activity" | "content"
  sourceId    String?  // chatMessageId or activityId
  reason      String   // "incorrect" | "biased" | "offtopic" | "other"
  comment     String?
  status      String   @default("open") // "open" | "reviewed" | "resolved"
  createdAt   DateTime @default(now())
}
