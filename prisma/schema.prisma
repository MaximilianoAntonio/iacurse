// Prisma schema - Plataforma de Aprendizaje Adaptativo Electromedicina II
// Piloto de Innovación Docente - Universidad de Valparaíso

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  role          String   @default("student") // "student" | "teacher"
  avatar        String?
  points        Int      @default(0)
  streak        Int      @default(0)
  weeklyGoalMin Int      @default(180) // Meta semanal de estudio en minutos
  lastActive    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  attempts      Attempt[]
  progress      Progress[]
  chatMessages  ChatMessage[]
  studySessions StudySession[]
  userBadges    UserBadge[]
  selfAssess    SelfAssessment[]
  errorReports  ErrorReport[]
  bookmarks     Bookmark[]
  courses       Course[]
  questionBanks QuestionBank[]
  dataResources DataResource[]
  rubrics       Rubric[]
}

model Unit {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  summary     String
  description String
  icon        String
  color       String
  order       Int
  lessons     Lesson[]
  progress    Progress[]
  objectives  LearningObjective[]
}

model Lesson {
  id          String   @id @default(cuid())
  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  slug        String
  title       String
  description String
  content     String
  durationMin Int      @default(15)
  order       Int
  activities  Activity[]
  objectives  LearningObjective[]
}

model Activity {
  id         String   @id @default(cuid())
  lessonId   String
  lesson     Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type       String   // "multiple_choice" | "guided_problem" | "case_analysis" | "progressive_exercise" | "self_assessment"
  title      String
  prompt     String
  data       String   // JSON: options, answer, hints, steps, explanation, rubric, etc.
  points     Int      @default(10)
  difficulty String   @default("medium") // "easy" | "medium" | "hard"
  order      Int

  // === Metadatos de evaluación (pedagógicos) ===
  assessmentType   String   @default("formative") // "diagnostic" | "formative" | "summative" | "self_reflection"
  bloomLevel       String   @default("apply") // "remember" | "understand" | "apply" | "analyze" | "evaluate" | "create"
  maxAttempts      Int      @default(3) // 0 = ilimitados
  masteryThreshold Int      @default(70) // 0-100, % mínimo para aprobar
  weight           Int      @default(1) // peso en la nota de la unidad
  timeLimitMin     Int?     // null = sin límite
  rubricId         String?  // rúbrica para respuestas abiertas
  rubric           Rubric?  @relation(fields: [rubricId], references: [id], onDelete: SetNull)

  attempts   Attempt[]
  bookmarks  Bookmark[]
  objectives ActivityObjective[]

  @@index([lessonId])
  @@index([assessmentType])
}

model Attempt {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  answer     String
  feedback   String?
  score      Int?
  correct    Boolean?
  timeSpent  Int?
  hintsUsed  Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([userId, activityId])
  @@index([userId, correct])
  @@index([activityId])
}

model Progress {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  completed   Int      @default(0)
  total       Int      @default(0)
  mastery     Int      @default(0) // 0-100
  lastVisited DateTime?
  updatedAt   DateTime @updatedAt

  @@unique([userId, unitId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   // "user" | "assistant"
  content   String
  context   String?
  rating    Int?     // 1-5 feedback from student
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, role])
}

model StudySession {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId    String?
  startedAt DateTime @default(now())
  duration  Int      @default(0)

  @@index([userId])
}

model Badge {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  icon        String
  tier        String   @default("bronze") // "bronze" | "silver" | "gold"
  userBadges  UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  awardedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

model SelfAssessment {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  unitId     String?
  confidence Int      // 1-5 student self-reported confidence
  reflection String?
  createdAt  DateTime @default(now())
}

model ErrorReport {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  source      String   // "chat" | "activity" | "content"
  sourceId    String?  // chatMessageId or activityId
  reason      String   // "incorrect" | "biased" | "offtopic" | "other"
  comment     String?
  status      String   @default("open") // "open" | "reviewed" | "resolved"
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([status])
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityId String
  activity   Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  note       String?
  createdAt  DateTime @default(now())

  @@unique([userId, activityId])
  @@index([userId])
}

// === Sistema de creación docente (Sandbox) ===
// Permite al docente crear cursos, bancos de preguntas y recursos de datos

model Course {
  id          String   @id @default(cuid())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  description String
  color       String   @default("sky")
  icon        String   @default("BookOpen")
  status      String   @default("draft") // "draft" | "published" | "archived"
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  units       CourseUnit[]

  @@index([authorId])
  @@index([status])
}

model CourseUnit {
  id          String   @id @default(cuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title       String
  summary     String
  description String
  icon        String   @default("BookOpen")
  color       String   @default("sky")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lessons     CourseLesson[]

  @@index([courseId])
}

model CourseLesson {
  id          String   @id @default(cuid())
  unitId      String
  unit        CourseUnit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  title       String
  description String
  content     String   // Markdown content
  durationMin Int      @default(15)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions   Question[]

  @@index([unitId])
}

model QuestionBank {
  id          String   @id @default(cuid())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  name        String
  description String?
  category    String   @default("general") // "mc" | "guided" | "case" | "self" | "general"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  questions   Question[]

  @@index([authorId])
  @@index([category])
}

model Question {
  id          String   @id @default(cuid())
  bankId      String?
  bank        QuestionBank? @relation(fields: [bankId], references: [id], onDelete: SetNull)
  lessonId    String?
  lesson      CourseLesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type        String   // "multiple_choice" | "guided_problem" | "case_analysis" | "progressive_exercise" | "self_assessment"
  title       String
  prompt      String
  data        String   // JSON: options, answer, hints, steps, explanation, rubric
  points      Int      @default(10)
  difficulty  String   @default("medium") // "easy" | "medium" | "hard"
  tags        String?  // Comma-separated tags for search
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([bankId])
  @@index([lessonId])
  @@index([type])
}

model DataResource {
  id          String   @id @default(cuid())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  name        String
  type        String   // "glossary" | "formula" | "diagram" | "reference" | "dataset"
  content     String   // Markdown or JSON content
  tags        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([authorId])
  @@index([type])
}

// === Sistema pedagógico: objetivos, rúbricas y mapeo ===

model LearningObjective {
  id          String   @id @default(cuid())
  // Vinculación: unit-level (null lessonId) o lesson-level
  unitId      String
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  lessonId    String?
  lesson      Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  code        String   // "O1", "O2", "U1-O1"...
  description String
  bloomLevel  String   @default("apply") // "remember" | "understand" | "apply" | "analyze" | "evaluate" | "create"
  createdAt   DateTime @default(now())

  activities  ActivityObjective[]

  @@index([unitId])
  @@index([lessonId])
}

model Rubric {
  id          String   @id @default(cuid())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  name        String
  description String?
  criteria    String   // JSON: [{ name, weight, levels: [{ score, label, description }] }]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  activities  Activity[]

  @@index([authorId])
}

model ActivityObjective {
  id          String   @id @default(cuid())
  activityId  String
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  objectiveId String
  objective   LearningObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@unique([activityId, objectiveId])
  @@index([activityId])
}
