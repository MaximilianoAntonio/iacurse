# ============================================================================
# Backend Django + PostgreSQL + Frontend Next.js
# Plataforma Electromedicina II — Piloto Innovación Docente UV
# ============================================================================
# Copia este archivo a .env y ajusta los valores.
#   cp .env.example .env
# ============================================================================

# --- PostgreSQL (lineamiento: PostgreSQL/MySQL) ---
POSTGRES_DB=electromed
POSTGRES_USER=electromed
POSTGRES_PASSWORD=electromed
POSTGRES_HOST=db
POSTGRES_PORT=5432
# O bien una URL completa (tiene precedencia sobre los componentes):
# DATABASE_URL=postgres://electromed:electromed@db:5432/electromed

# --- Django ---
DJANGO_MODE=dev              # dev | prod
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=cambia-esto-en-produccion-genera-uno-con-python-secrets
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
TIME_ZONE=America/Santiago

# --- Cookies de sesión/CSRF ---
# Producción con HTTPS (default seguro en config/settings/prod.py):
#   SESSION_COOKIE_SECURE=1 / CSRF_COOKIE_SECURE=1 / SAMESITE=Lax
#   (con Caddy frontend y API van bajo el mismo origen: Lax basta y es más
#    seguro; usar None solo si frontend y API están en orígenes distintos)
# Producción por HTTP plano (sin TLS, p. ej. piloto en red interna):
#   los navegadores rechazan cookies Secure y SameSite=None sin Secure;
#   usar entonces:
#SESSION_COOKIE_SECURE=0
#CSRF_COOKIE_SECURE=0
#SESSION_COOKIE_SAMESITE=Lax
#CSRF_COOKIE_SAMESITE=Lax
# Días de inactividad antes de expirar la sesión (default 7; la cookie se
# renueva con cada request autenticado: es un timeout de inactividad).
#SESSION_COOKIE_AGE_DAYS=7

# --- Transporte seguro (prod; activar SOLO con HTTPS ya operativo) ---
#SECURE_SSL_REDIRECT=1
#SECURE_HSTS_SECONDS=31536000

# --- HTTPS / TLS con Caddy (ver DEPLOY.md §9) ---
# Dominio público del servidor. Con un dominio real Caddy emite y renueva
# el certificado Let's Encrypt automáticamente; DOMAIN=localhost usa la CA
# interna de Caddy (autofirmado, solo para probar en local).
# Se usa con: docker compose -f docker-compose.yml -f docker-compose.tls.yml up --build -d
#DOMAIN=midominio.uv.cl

# --- Rate limiting (DRF) ---
#THROTTLE_ANON=60/minute
#THROTTLE_USER=600/minute
#THROTTLE_LOGIN=10/minute
#THROTTLE_TELEMETRY=240/minute

# --- Retención de registros (días; política 12 meses en caliente) ---
#TELEMETRY_RETENTION_DAYS=365
#AUDIT_LOG_RETENTION_DAYS=365

# --- Consentimiento informado electrónico (uso científico de datos) ---
# Versión del documento que se registra como evidencia de la decisión.
#CONSENT_VERSION=2026-08-V2
# Plazo máximo para retirar la autorización (fecha ISO); pasada esa fecha
# el endpoint de retiro rechaza la solicitud.
#CONSENT_REVOKE_DEADLINE=2026-12-11

# --- Datos demo ---
# NUNCA en producción. Solo para pruebas: fuerza seed_demo con DB vacía.
#LOAD_DEMO_DATA=0

# --- CORS (frontend Next.js) ---
# En producción: reemplazar por el/los dominios reales del frontend.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Protección del login (anti fuerza bruta) ---
# Captcha autoalojado (django-simple-captcha, operación matemática en imagen).
# 1 = exigir captcha en /api/auth/login (default), 0 = desactivar.
LOGIN_CAPTCHA_ENABLED=1
# Rate limit por IP en el login (formato DRF: número/s|m|h|d).
LOGIN_THROTTLE_RATE=5/min

# --- MFA docente por código de un solo uso (hallazgo 2.9) ---
# Activo por defecto en producción (prod.py); en dev está desactivado.
# Los estudiantes (anonimizados, sin email) quedan exentos.
#TEACHER_MFA_ENABLED=1
#MFA_CODE_TTL_MINUTES=10
#MFA_MAX_ATTEMPTS=5
# SMTP institucional para enviar el código (OBLIGATORIO en producción con
# MFA activo: prod.py aborta el arranque si falta). En dev el código se
# imprime en la consola del backend (EMAIL_BACKEND=console por defecto).
#EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#EMAIL_HOST=smtp.uv.cl
#EMAIL_PORT=587
#EMAIL_HOST_USER=
#EMAIL_HOST_PASSWORD=
#EMAIL_USE_TLS=1
#DEFAULT_FROM_EMAIL=Plataforma Electromedicina II <no-reply@uv.cl>

# --- IA generativa (lineamiento: API de IA generativa) ---
# Hallazgo 2.3 (informe de seguridad oct-2026): la IA está DESACTIVADA por
# defecto ("fallback"): ningún dato de estudiantes sale del servidor y las
# funciones de IA responden con fallbacks en español. Reactivar SOLO tras
# regularizar la transferencia (certificación DTIC/Ciberseguridad + DPO):
# al hacerlo se envían respuestas de actividades y del diagnóstico general
# al proveedor (sin student_code ni identificadores).
AI_PROVIDER=fallback         # fallback | openai | gemini
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=
# Opcional: base URL para APIs OpenAI-compatibles (p. ej. Kimi/Moonshot).
# OPENAI_BASE_URL=https://api.kimi.com/coding/v1   # con AI_MODEL=kimi-for-coding
OPENAI_BASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- CAAMI + RAG (motor pedagógico de andamiaje adaptativo, app tutor) ---
# CAAMI_ENABLED=0 fuerza los fallbacks pedagógicos aunque la IA esté activa
# (el motor de niveles A1-A5 es determinista y funciona siempre).
#CAAMI_ENABLED=1
# RAG: recuperación de contexto del corpus (manage.py ingest_corpus).
# Requiere un provider con embeddings; desactivado por defecto.
#RAG_ENABLED=0
#AI_EMBEDDING_MODEL=text-embedding-3-small   # Gemini: models/text-embedding-004
#KB_VERSION=KB_v1
#RAG_TOP_K=3

# --- Telemetría ---
# Umbral de alarma de uso diario en minutos (lineamiento: dependencia tecnológica)
TELEMETRY_DAILY_USAGE_ALERT_MIN=360

# --- Frontend Next.js ---
# URL pública del backend tal como la ve el navegador del usuario.
# Se incrusta en el bundle en build-time: cambiarla exige rebuild del frontend.
NEXT_PUBLIC_API_URL=http://localhost:8000
FRONTEND_PORT=3000
BACKEND_PORT=8000
